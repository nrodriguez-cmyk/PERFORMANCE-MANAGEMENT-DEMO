# =========================================================================
# CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL / SUPABASE)
# =========================================================================

# Opción 1: Conexión Directa PostgreSQL o Supabase Pooler (Recomendada)
# Ejemplo Supabase: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Ejemplo PostgreSQL local o VPS: postgresql://usuario:contraseña@localhost:5432/canguro_evaluaciones
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres"

# Opción 2: Credenciales API de Supabase (REST API)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-de-supabase"

# =========================================================================
# SERVICIOS DE CORREO (CONVOCATORIAS OFICIALES)
# =========================================================================
SMTP_USER="notificaciones@elcanguro.com"
SMTP_PASS="tu_contraseña_o_app_password"
SMTP_SERVICE="gmail"

# =========================================================================
# INTELIGENCIA ARTIFICIAL (GEMINI API)
# =========================================================================
GEMINI_API_KEY="TU_GEMINI_API_KEY"

# URL base de la aplicación
APP_URL="http://localhost:3000"
